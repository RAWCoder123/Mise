{
  "name": "mise-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "test": "node --test --import tsx 'tests/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "qa:routes": "node scripts/mobile-route-smoke.mjs",
    "qa:mobile-layout": "node scripts/mobile-layout-smoke.mjs",
    "qa:interactions": "MISE_QA_INTERACTIONS=1 node scripts/mobile-layout-smoke.mjs",
    "qa:ios-prereq": "node scripts/ios-native-prereq.mjs",
    "qa:eas-account": "node scripts/eas-account-prereq.mjs",
    "qa:eas-archive": "node scripts/eas-archive-prereq.mjs",
    "observability:check": "node scripts/verify-observability.mjs",
    "recovery:staging-check": "node --env-file-if-exists=.mise-staging.env scripts/staging-backup-restore-check.mjs",
    "staging:emergency-mode-check": "node --env-file-if-exists=.mise-staging.env scripts/staging-emergency-mode-check.mjs",
    "staging:account-deletion-check": "node --env-file-if-exists=.mise-staging.env scripts/staging-account-deletion-check.mjs",
    "staging:restaurant-export-check": "node --env-file-if-exists=.mise-staging.env scripts/staging-restaurant-export-check.mjs",
    "security:static": "node scripts/security-static.mjs",
    "security:backend": "node scripts/security-backend.mjs",
    "design:static": "node scripts/design-static.mjs",
    "supabase:test": "node scripts/supabase-local-test.mjs",
    "staging:seed": "node --env-file-if-exists=.mise-staging.env scripts/staging-seed.mjs",
    "staging:tenant-check": "node --env-file-if-exists=.mise-staging.env scripts/staging-tenant-check.mjs",
    "staging:service-rpc": "node --env-file-if-exists=.mise-staging.env scripts/staging-service-rpc-check.mjs",
    "staging:edge-concurrency": "node --env-file-if-exists=.mise-staging.env scripts/staging-edge-concurrency.mjs",
    "staging:client-race": "node --env-file-if-exists=.mise-staging.env scripts/staging-client-race.mjs",
    "staging:learning-check": "node --env-file-if-exists=.mise-staging.env scripts/staging-learning-check.mjs",
    "staging:finding-decision-check": "node --env-file-if-exists=.mise-staging.env scripts/staging-finding-decision-check.mjs",
    "staging:owner-invitation-check": "node --import tsx --env-file-if-exists=.mise-staging.env scripts/staging-owner-invitation-check.mjs",
    "beta:provision-owner": "node --env-file-if-exists=.mise-staging.env scripts/beta-restaurant-provisioning.mjs",
    "pilot:controls": "node --env-file-if-exists=.mise-staging.env scripts/pilot-restaurant-controls.mjs",
    "demo:ready": "npm run typecheck && npm test && npm audit --audit-level=high && npm run doctor && npm run security:backend && npm run design:static && npx expo export --platform web --output-dir /private/tmp/mise-web-export && npm run qa:interactions",
    "verify:beta": "npm run typecheck && npm test && npm audit --audit-level=high && npm run doctor && npm run security:backend && npm run design:static && npx expo export --platform web --output-dir /private/tmp/mise-web-export && npm run qa:routes && npm run qa:interactions",
    "verify:private-beta-security:local": "npm run typecheck && npm test && npm audit --audit-level=high && npm run doctor && npm run security:backend && npm run design:static && npm run supabase:test && npx expo export --platform web --output-dir /private/tmp/mise-web-export && npm run qa:routes && npm run qa:interactions",
    "verify:private-beta-security:hosted": "node --env-file-if-exists=.mise-staging.env scripts/verify-hosted-security.mjs",
    "verify:private-beta-security": "node --env-file-if-exists=.mise-staging.env scripts/verify-private-beta-security.mjs",
    "verify:paid-product": "npm run verify:private-beta-security",
    "ios:testflight:check": "npm run qa:eas-archive && npm run qa:eas-account && npm run qa:ios-prereq && npm run demo:ready",
    "beta:go-no-go": "node --import tsx scripts/beta-go-no-go.ts",
    "ios:testflight:build": "npx --yes eas-cli@21.4.0 build --platform ios --profile testflight",
    "ios:testflight:submit": "npx --yes eas-cli@21.4.0 submit --platform ios --profile testflight --latest"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~56.0.18",
    "expo-auth-session": "~56.0.16",
    "expo-camera": "~56.0.8",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.22",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.16",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.17",
    "expo-sharing": "~56.0.23",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.6",
    "lucide-react-native": "^1.18.0",
    "posthog-react-native": "^4.60.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "expo-doctor": "1.20.1",
    "pg": "^8.23.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.8"
  }
}
