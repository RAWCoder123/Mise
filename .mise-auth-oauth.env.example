# Copy to .mise-auth-oauth.env (gitignored). Never commit real values.
# Then run:
#   node --env-file-if-exists=.mise-staging.env --env-file=.mise-auth-oauth.env scripts/enable-social-auth.mjs

SUPABASE_ACCESS_TOKEN=

# Google Cloud → Auth Platform → Clients → Web application
# Authorized redirect URI must include:
#   https://<project-ref>.supabase.co/auth/v1/callback
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Apple Developer → Sign in with Apple → Services ID + .p8 key → client secret JWT
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
