EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_ENABLE_DEMO_MODE=true
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# HTTPS-only Privacy Policy URL for App Store / in-app legal links. Leave blank until published.
EXPO_PUBLIC_PRIVACY_URL=

# Backend-only Supabase Edge Function secrets for restaurant Gmail delivery.
# Configure these with `supabase secrets set`; never add EXPO_PUBLIC_ prefixes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MISE_APP_GMAIL_REDIRECT_URI=
GMAIL_MESSAGE_ID_DOMAIN=mail.mise.app
GMAIL_SEND_ENABLED=false

# Backend-only Supabase Edge Function secrets for Square POS OAuth/sync.
# Configure with `supabase secrets set`; never add EXPO_PUBLIC_ prefixes.
# Keep square_sync_enabled / square_webhooks_enabled false until staging proof.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URI=
SQUARE_ENVIRONMENT=sandbox
MISE_APP_SQUARE_REDIRECT_URI=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Hosted Auth social login (Google/Apple). Separate from Gmail send credentials.
# Used by scripts/enable-social-auth.mjs and local `supabase start` env substitution.
# Create a personal access token at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_APPLE_CLIENT_ID=
SUPABASE_AUTH_APPLE_SECRET=
# Local GoTrue env aliases (same values as above):
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Trusted Node-only disposable staging configuration. Never prefix these with
# EXPO_PUBLIC_ and never commit populated values.
SUPABASE_STAGING_URL=
SUPABASE_STAGING_PROJECT_REF=
SUPABASE_STAGING_ANON_KEY=
SUPABASE_STAGING_SECRET_KEY=
MISE_STAGING_MARKER=
MISE_STAGING_SEED_PASSWORD=

# Supabase Edge Function secrets for the service-only Mise outreach agent.
# Set these with `supabase secrets set`; never expose them as EXPO_PUBLIC_ values.
MISE_OUTREACH_AGENT_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_OUTREACH_MODEL=gpt-5.6
MISE_OUTREACH_UNSUBSCRIBE_BASE_URL=
